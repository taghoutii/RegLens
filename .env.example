# Copy this file to .env and replace the values.  .env is git-ignored.
# All values below are fake / local-development only.

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333

# --- Redis (job queue, job status, semantic cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Chunking (optional: fixes the semantic cut threshold instead of calibrating it) ---
# CHUNK_SEMANTIC_THRESHOLD=0.4561

# --- LLM (used from Phase 8; "fake" needs no key) ---
LLM_PROVIDER=fake
MISTRAL_API_KEY=your-mistral-key-here

# --- Logging ---
LOG_LEVEL=INFO
