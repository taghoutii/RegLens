# Copy this file to .env and replace the values.  .env is git-ignored.
# All values below are fake / local-development only.

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333

# --- Redis (job queue + semantic cache) ---
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL (exact table values) ---
POSTGRES_USER=reglens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=reglens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- LLM (used from Phase 8; "fake" needs no key) ---
LLM_PROVIDER=fake
MISTRAL_API_KEY=your-mistral-key-here

# --- Logging ---
LOG_LEVEL=INFO
